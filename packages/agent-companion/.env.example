# Copy to .env and adjust as needed for local llama.cpp evals.

# Optional Hugging Face token. Public repos work without it; gated repos need it.
HF_TOKEN=

# Where model files should live locally.
LOGION_MODEL_CACHE_DIR=${HOME}/models/logion-evals

# Which public GGUFs to download.
LOGION_DOWNLOAD_QWEN3_4B=1
LOGION_DOWNLOAD_QWEN3_8B=1
LOGION_DOWNLOAD_GEMMA3_4B=1

QWEN3_4B_REPO=Qwen/Qwen3-4B-GGUF
QWEN3_4B_FILE=Qwen3-4B-Q4_K_M.gguf
QWEN3_8B_REPO=Qwen/Qwen3-8B-GGUF
QWEN3_8B_FILE=Qwen3-8B-Q4_K_M.gguf
GEMMA3_4B_REPO=unsloth/gemma-3-4b-it-GGUF
GEMMA3_4B_FILE=gemma-3-4b-it-Q4_K_M.gguf

# Eval runner defaults.
LOGION_LLAMACPP_CONFIG=evals/providers/llama_cpp_local.example.yaml
LOGION_LLAMACPP_MODEL_ID=qwen3-8b-q5km
LOGION_EVAL_SCENARIOS=evals/scenarios
LOGION_EVAL_CATALOG=evals/catalogs/fake-marketplace.yaml
LOGION_EVAL_REPORT=evals/reports/last-run.json
LLAMA_SERVER_BIN=llama-server
