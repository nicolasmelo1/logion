#!/bin/sh

set -eu

if ! uv sync --all-packages --check >/dev/null 2>&1; then
	echo "Workspace dependencies are not fully synced."
	echo "Run: uv sync --all-packages"
	exit 1
fi

echo "Running Ruff..."
uv run ruff check packages/

echo "Running format check..."
uv run ruff format --check packages/

echo "Running type check..."
uv run mypy packages/ --ignore-missing-imports

echo "Running tests..."
uv run pytest packages/ -m "not integration" --no-header -q

echo "Checking generated models..."
(cd packages/client && make check-models)

echo "Running dependency audit..."
uv run pip-audit --skip-editable

echo "Running Bandit..."
uv run bandit -c pyproject.toml -r packages

echo "Running secret scan..."
staged_files="$(git diff --cached --name-only --diff-filter=ACMR)"
if [ -n "${staged_files}" ]; then
	printf '%s\n' "${staged_files}" | xargs uv run detect-secrets-hook --baseline .secrets.baseline
fi

echo "Running public guardrails..."
make ci-checks

# ── installer checks — mirror the installer job in pr-safety.yml.
# The security scanner runs for every commit through make ci-checks.
# Run the heavier installer linters/tests only when installer files change.
installer_staged="$(git diff --cached --name-only --diff-filter=ACMR \
    | grep -E '^(scripts/install(\.sh|_lib\.sh|\.ps1|_lib\.ps1)|scripts/install_test/|tests/install/|scripts/check_installer_security\.py|Makefile|\.githooks/pre-commit|\.github/workflows/pr-safety\.yml)$' || true)"
if [ -n "${installer_staged}" ]; then
	echo "Installer files staged — running installer lint/security/tests..."
	for tool in shellcheck bats pwsh; do
		if ! command -v "${tool}" >/dev/null 2>&1; then
			echo "Error: ${tool} is required to validate installer changes."
			echo "Install shellcheck, bats, and PowerShell, then retry."
			exit 1
		fi
	done
	make install-test
fi

# ── npm-wrapper checks — mirror the npm-wrapper job in pr-safety.yml.
# Only run when files under packages/npm-wrapper/** are staged, so the
# hook stays fast for Python-only changes.
npm_staged="$(git diff --cached --name-only --diff-filter=ACMR \
    | grep -E '^packages/npm-wrapper/' || true)"
if [ -n "${npm_staged}" ]; then
	echo "npm-wrapper files staged — running npm-wrapper checks..."
	if ! command -v node >/dev/null 2>&1; then
		echo "Error: node is required to validate npm-wrapper changes."
		echo "Install Node ≥22 (see packages/npm-wrapper/.nvmrc)."
		exit 1
	fi
	(
		cd packages/npm-wrapper

		if [ ! -d node_modules ]; then
			echo "Installing npm-wrapper dependencies..."
			npm ci --ignore-scripts
		fi

		echo "Running npm-wrapper lint (eslint)..."
		npm run lint

		echo "Running npm-wrapper format check (prettier)..."
		npm run format:check

		echo "Running npm-wrapper type check (tsc --noEmit)..."
		npm run typecheck

		echo "Running npm-wrapper tests (vitest)..."
		npm test
	)
fi

# ── agent-proving-ground checks — keep the package strongly typed and tested.
# Only run when files under packages/agent-proving-ground/** are staged.
agent_pg_staged="$(git diff --cached --name-only --diff-filter=ACMR \
    | grep -E '^packages/agent-proving-ground/' || true)"
if [ -n "${agent_pg_staged}" ]; then
	echo "agent-proving-ground files staged — running package verification..."
	make agent-proving-ground-verify
fi

# ── social-management checks — only run when files under
# packages/social-management/** are staged, so the hook stays fast
# for changes to other packages.
social_staged="$(git diff --cached --name-only --diff-filter=ACMR \
    | grep -E '^packages/social-management/' || true)"
if [ -n "${social_staged}" ]; then
	echo "social-management files staged — running social-management checks..."

	echo "Running social-management lint (ruff)..."
	uv run ruff check packages/social-management/

	echo "Running social-management format check (ruff)..."
	uv run ruff format --check packages/social-management/

	echo "Running social-management type check (mypy)..."
	uv run mypy packages/social-management/ --ignore-missing-imports

	echo "Running social-management tests + architecture..."
	uv run pytest packages/social-management/tests/ -q --no-header
fi

echo "All checks passed."
