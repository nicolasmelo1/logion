# Pinned linux/arm64 role image for the bounded local node.
FROM --platform=linux/arm64 python:3.12-slim-bookworm

ARG LOGION_BASE_URL=http://localhost:8000
ARG CODEX_VERSION=0.150.1
ENV LOGION_BASE_URL=${LOGION_BASE_URL}

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
    nodejs \
    npm \
  && npm install --global "@openai/codex@${CODEX_VERSION}" \
  && codex --version \
  && rm -rf /var/lib/apt/lists/* /root/.npm

COPY dist-wheels/ /opt/logion-wheels/
RUN pip install --no-cache-dir /opt/logion-wheels/*.whl
COPY codex-role /usr/local/bin/codex-role

RUN useradd --create-home --uid 10001 --shell /usr/sbin/nologin agent \
  && mkdir -p /home/agent/.logion/spool /workspace/task \
  && chmod 0777 /home/agent /home/agent/.logion /home/agent/.logion/spool \
    /workspace /workspace/task \
  && chmod 0755 /usr/local/bin/codex-role
USER agent
WORKDIR /workspace/task
ENTRYPOINT []
CMD ["sh", "-c", "exec timeout --signal=TERM 3600 sleep infinity"]
