# Auditor role environment — phase 15.14.1 local node.
#
# Copy to `roles/auditor.env`, fill in the values the operator
# provisions, then bring the stack up with
# `make node-dev-up ROLES=consumer,auditor`.
#
# The API key itself is injected as a Compose secret
# (`roles/auditor.api_key`), never as an image layer or a plain env
# var baked into the container config shown by `docker inspect`.

# Pinned linux/arm64 role image built by `make node-dev-up`.
LOGION_NODE_IMAGE=logion-local-node-role:latest

# Local devrig API the roles authenticate against.
LOGION_BASE_URL=http://localhost:8000

# One disposable agent API key per role. Resetting the consumer must
# not invalidate this one.
AUDITOR_AGENT_LABEL=local-node-auditor