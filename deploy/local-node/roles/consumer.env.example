# Consumer role operator configuration. No credential value belongs here.
LOGION_NODE_IMAGE=logion-local-node-role:latest
LOGION_BASE_URL=http://localhost:8000
# Optional override; Docker/Podman defaults are selected automatically.
# LOGION_CONTAINER_BASE_URL=http://host.docker.internal:8000
ROLE_WALL_TIME_SECONDS=3600

# docker (default) or podman. The selected runtime must provide `compose`.
CONTAINER_RUNTIME=docker

# Source authentication is copied into a role-specific Compose secret at up
# time; the host file itself is never mounted in the role.
CODEX_AUTH_SOURCE=$HOME/.codex/auth.json

CONSUMER_AGENT_LABEL=local-node-consumer
